{
  "manifest_version": 3,
  "name": "카페 읽음 표시",
  "version": "2.5.0",
  "description": "네이버 카페의 읽음·새 댓글 표시, 닉네임 차단과 차단 안내 숨김, 단축키, 좋아요 자동 재시도를 지원합니다.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "contextMenus", "alarms"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "카페 읽음 표시", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["*://cafe.naver.com/*", "*://m.cafe.naver.com/*"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start",
    "css": ["block-content.css"],
    "js": ["block-core.js", "block-content.js"]
  }, {
    "matches": ["*://cafe.naver.com/*", "*://m.cafe.naver.com/*", "*://section.cafe.naver.com/*"],
    "all_frames": true,
    "run_at": "document_idle",
    "css": ["content.css"],
    "js": ["core.js", "content.js", "like.js", "hotkeys.js", "newmark.js"]
  }, {
    "matches": ["*://cafe.naver.com/*", "*://m.cafe.naver.com/*"],
    "all_frames": true,
    "run_at": "document_start",
    "world": "MAIN",
    "js": ["like-hook.js"]
  }]
}
